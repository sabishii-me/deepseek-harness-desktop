import { defineEventHandler } from 'h3'
import { getServerOptions } from 'dsh-h3/utils'
import type { Config } from '../../../config/options'
import { installJouzu } from '../../../service/jouzu-install'
import { backend } from '../../../service/backend'

export default defineEventHandler(async (event) => {
  await installJouzu(getServerOptions<Config>(event).jouzuPath)
  return backend.getCatalog()
})
